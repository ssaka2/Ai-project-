[Unit]
Description=AI Office private recruiting pilot
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ai-office
Group=ai-office
WorkingDirectory=/opt/ai-office
EnvironmentFile=/etc/ai-office.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 /opt/ai-office/office.py --db /var/lib/ai-office/office.sqlite3 --port 4521
Restart=on-failure
RestartSec=5
StateDirectory=ai-office
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
