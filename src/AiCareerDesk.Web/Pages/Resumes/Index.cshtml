@page
@model AiCareerDesk.Web.Pages.Resumes.IndexModel
@{ ViewData["Title"] = "My resumes"; }
<div class="heading"><h1>My resumes</h1><a class="button" asp-page="Edit">Add a base resume</a></div>
<p>Keep your original experience here. Create a separate draft for each opportunity.</p>
@if (Model.Items.Count == 0) { <p>No resumes yet. Paste your resume text to get started.</p> }
@foreach (var resume in Model.Items)
{
    <article class="job"><h2><a asp-page="Edit" asp-route-id="@resume.Id">@resume.Name</a></h2>
    <p>Updated @resume.UpdatedUtc.ToString("yyyy-MM-dd") UTC</p></article>
}
<div class="heading"><h2>Job-specific drafts</h2><a class="button" asp-page="CreateDraft">Create a draft</a></div>
@if (Model.Drafts.Count == 0) { <p>Your drafts will appear here.</p> }
@foreach (var draft in Model.Drafts)
{
    <article class="job"><h2><a asp-page="Draft" asp-route-id="@draft.Id">@draft.Name</a></h2>
    <p>Updated @draft.UpdatedUtc.ToString("yyyy-MM-dd") UTC</p></article>
}
