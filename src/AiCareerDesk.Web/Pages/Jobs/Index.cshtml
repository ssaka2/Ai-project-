@page
@model AiCareerDesk.Web.Pages.Jobs.IndexModel
@{
    ViewData["Title"] = "My jobs";
}
<div class="heading"><h1>My job dashboard</h1><a class="button" asp-page="Create">Save a job</a></div>
<div class="cards stats">
@foreach (var item in Model.Counts)
{
    <a asp-page="Index" asp-route-status="@item.Key"><strong>@item.Value</strong> @item.Key</a>
}
</div>
<p><a asp-page="FollowUps">Follow-ups due: @Model.DueCount</a> · <a asp-page-handler="Export" asp-route-status="@Model.Status" asp-route-search="@Model.Search">Download filtered applications (CSV)</a></p>
<form method="get" class="filter">
    <label asp-for="Search">Search title, company or location</label>
    <input asp-for="Search" type="search" maxlength="200" />
    <label asp-for="Status">Filter by status</label>
    <select asp-for="Status" asp-items="Html.GetEnumSelectList<ApplicationStatus>()"><option value="">All statuses</option></select>
    <button type="submit">Filter</button><a asp-page="Index">Clear</a>
</form>
@if (Model.Items.Count == 0)
{
    <p>No applications match this view. Clear the filters or save an opportunity to start tracking it.</p>
}
@foreach (var job in Model.Items)
{
    <article class="job">
        <h2><a asp-page="Edit" asp-route-id="@job.Id">@job.Title</a></h2>
        <p>@job.Company · @job.Location</p>
        @if (!string.IsNullOrWhiteSpace(job.ApplicationUrl))
        {
            <a href="@job.ApplicationUrl" target="_blank" rel="noopener noreferrer">Open employer application</a>
        }
        <span class="badge">@job.Status</span>
        <p>Updated @job.UpdatedUtc.ToString("yyyy-MM-dd") UTC</p>
    </article>
}
