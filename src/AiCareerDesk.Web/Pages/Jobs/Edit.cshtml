@page "{id:guid}"
@model AiCareerDesk.Web.Pages.Jobs.EditModel
@{ ViewData["Title"] = "Edit job"; }
<h1>Edit job</h1>
<p><a href="@Request.Path" target="_blank" rel="noopener">Open latest saved version in a new tab</a></p>
<form method="post" class="editor">
    <input type="hidden" asp-for="Input.Version" />
    <div asp-validation-summary="All" class="validation" role="alert"></div>
    <label asp-for="Input.Title"></label><input asp-for="Input.Title" />
    <label asp-for="Input.Company"></label><input asp-for="Input.Company" />
    <label asp-for="Input.Location"></label><input asp-for="Input.Location" />
    <label asp-for="Input.ApplicationUrl"></label><input asp-for="Input.ApplicationUrl" />
    <label asp-for="Input.Description"></label><textarea asp-for="Input.Description" rows="8"></textarea>
    <label asp-for="Input.Notes"></label><textarea asp-for="Input.Notes" rows="4"></textarea>
    <label asp-for="Input.Status"></label><select asp-for="Input.Status" asp-items="Html.GetEnumSelectList<ApplicationStatus>()"></select>
    <p>Choose Applied only after you have submitted your application on the employer's website.</p>
    <button type="submit">Save changes</button>
    <a asp-page="Index">Back to jobs</a>
</form>
<a asp-page="Delete" asp-route-id="@RouteData.Values["id"]">Delete this job</a>

<h2>Status history</h2>
@if (Model.History.Count == 0) { <p>No status changes yet.</p> }
@foreach (var change in Model.History)
{
    <p>@change.ChangedUtc.ToString("yyyy-MM-dd HH:mm") UTC: @change.FromStatus → @change.ToStatus</p>
}
