@page
@model AiCareerDesk.Web.Areas.Identity.Pages.Account.ForgotPasswordModel
@{ Layout = "/Pages/Shared/_Layout.cshtml"; ViewData["Title"] = "Forgot your password?"; }
<h1>Forgot your password?</h1>
<p>Enter your email to request a password reset link.</p>
<form method="post" class="editor">
    <div asp-validation-summary="All" class="validation" role="alert"></div>
    <label asp-for="Input.Email"></label>
    <input asp-for="Input.Email" autocomplete="username" />
    <button type="submit">Reset Password</button>
</form>
<p><a asp-page="./Login">Back to sign in</a></p>
